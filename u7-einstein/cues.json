[
 {
  "t0": 0.1,
  "t1": 3.316666666666667,
  "text": "Einstein. Genius. Failed maths."
 },
 {
  "t0": 3.466666666666667,
  "t1": 5.516666666666667,
  "text": "Except... he didn't."
 },
 {
  "t0": 5.666666666666666,
  "t1": 8.35,
  "text": "Einstein: the maths myth."
 },
 {
  "t0": 8.5,
  "t1": 11.816666666666666,
  "text": "By 15, he'd taught himself calculus."
 },
 {
  "t0": 11.966666666666667,
  "t1": 15.55,
  "text": "His words: \"I never failed in mathematics.\""
 },
 {
  "t0": 15.700000000000001,
  "t1": 17.75,
  "text": "So where did it come from?"
 },
 {
  "t0": 17.900000000000002,
  "t1": 22.516666666666666,
  "text": "In 1935, a newspaper column said he flunked."
 },
 {
  "t0": 22.666666666666668,
  "t1": 25.349999999999998,
  "text": "Einstein saw it and laughed."
 },
 {
  "t0": 25.5,
  "t1": 29.15,
  "text": "One theory: his Swiss school flipped its grades."
 },
 {
  "t0": 29.3,
  "t1": 31.48333333333333,
  "text": "6 was the top mark."
 },
 {
  "t0": 31.633333333333333,
  "t1": 34.28333333333333,
  "text": "He got 6s in maths."
 },
 {
  "t0": 34.43333333333333,
  "t1": 37.61666666666667,
  "text": "He did fail one exam, at 16."
 },
 {
  "t0": 37.766666666666666,
  "t1": 41.78333333333333,
  "text": "A university entrance exam. Two years early."
 },
 {
  "t0": 41.93333333333333,
  "t1": 45.38333333333333,
  "text": "He aced maths and physics. Not the rest."
 },
 {
  "t0": 45.53333333333333,
  "t1": 48.016666666666666,
  "text": "A year later, he got in."
 },
 {
  "t0": 48.166666666666664,
  "t1": 51.81666666666666,
  "text": "But \"genius fails maths\" is a better story."
 },
 {
  "t0": 51.96666666666666,
  "t1": 54.05,
  "text": "So the story stuck."
 },
 {
  "t0": 54.199999999999996,
  "t1": 57.55,
  "text": "Einstein's maths grades: top marks."
 },
 {
  "t0": 57.699999999999996,
  "t1": 60.65,
  "text": "Times he failed maths: zero."
 },
 {
  "t0": 60.8,
  "t1": 64.55,
  "text": "Anyway, here's Einstein failing maths."
 }
