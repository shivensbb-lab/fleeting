{
 "dur": 46.14,
 "cues": [
  {
   "id": "v01",
   "t0": 1.0,
   "vo_end": 4.896,
   "text": "Before dawn, 6 June 1944.",
   "t1": 5.496
  },
  {
   "id": "v02",
   "t0": 5.296,
   "vo_end": 8.552,
   "text": "Ships left ports all along the south coast of England.",
   "t1": 9.152
  },
  {
   "id": "v03",
   "t0": 8.952,
   "vo_end": 14.403,
   "text": "They gathered south of the Isle of Wight: \"Piccadilly Circus\".",
   "t1": 15.003
  },
  {
   "id": "v04",
   "t0": 14.803,
   "vo_end": 17.886,
   "text": "Nearly 7,000 vessels crossed the Channel.",
   "t1": 18.486
  },
  {
   "id": "v05",
   "t0": 18.386,
   "vo_end": 23.448,
   "text": "Their targets: five beaches along about 80 km of Normandy.",
   "t1": 24.048
  },
  {
   "id": "v06",
   "t0": 23.748,
   "vo_end": 26.802,
   "text": "Utah. Omaha. Gold. Juno. Sword.",
   "t1": 27.402
  },
  {
   "id": "v07",
   "t0": 27.402,
   "vo_end": 33.102,
   "text": "Near Omaha, US Rangers climbed the 30 m cliffs of Pointe du Hoc.",
   "t1": 33.702
  },
  {
   "id": "v08",
   "t0": 33.702,
   "vo_end": 40.166,
   "text": "By nightfall, about 156,000 Allied troops had landed, by sea and air.",
   "t1": 40.766
  },
  {
   "id": "v09",
   "t0": 40.766,
   "vo_end": 43.142,
   "text": "The way back into Europe was open.",
   "t1": 44.742
  }
 ]
}