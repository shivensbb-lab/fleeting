# Copy this file to .env.local and fill in your own values.
# Never commit .env.local: it holds secrets.
# Without Supabase and Stripe keys the app runs in demo mode with sample deals.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (database + auth) ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Used by the cron job to write deals. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (payments + subscriptions) ---
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PRO_PRICE_ID=
STRIPE_VIP_PRICE_ID=
# Percentage Fleeting keeps from each booking (default 12)
PLATFORM_FEE_PERCENT=12

# --- Deal sources (optional) ---
EVENTBRITE_TOKEN=
YELP_API_KEY=

# --- Cron ---
# Protects /api/cron/refresh-deals. Any long random string.
CRON_SECRET=
