[
 {
  "t0": 0.25,
  "t1": 2.238,
  "text": "Here's a maths problem."
 },
 {
  "t0": 4.25,
  "t1": 7.449,
  "text": "Mia has 3 times as many marbles as Ben."
 },
 {
  "t0": 8.25,
  "t1": 11.986,
  "text": "Together, they have 24. How many does Ben have?"
 },
 {
  "t0": 13.0,
  "t1": 15.443,
  "text": "Tricky? Not the S.A.M way."
 },
 {
  "t0": 18.25,
  "t1": 20.416,
  "text": "Step 1. Make it real."
 },
 {
  "t0": 22.25,
  "t1": 25.59,
  "text": "1 block for Ben. 3 blocks for Mia."
 },
 {
  "t0": 26.25,
  "t1": 29.881,
  "text": "Every block is the same size. That's the secret."
 },
 {
  "t0": 30.25,
  "t1": 32.451,
  "text": "Step 2. Draw a picture."
 },
 {
  "t0": 34.25,
  "t1": 37.549,
  "text": "Each block becomes a bar. We call it a unit."
 },
 {
  "t0": 38.25,
  "t1": 40.959,
  "text": "All the units together make 24."
 },
 {
  "t0": 42.25,
  "t1": 44.564,
  "text": "Step 3. Now the numbers."
 },
 {
  "t0": 46.25,
  "t1": 48.452,
  "text": "4 units = 24"
 },
 {
  "t0": 51.0,
  "t1": 53.027,
  "text": "So 1 unit = 6"
 },
 {
  "t0": 54.25,
  "t1": 57.474000000000004,
  "text": "Ben has 6. Mia has 18."
 },
 {
  "t0": 58.25,
  "t1": 63.355,
  "text": "Concrete. Pictorial. Abstract. That's Singapore Maths."
 },
 {
  "t0": 66.25,
  "t1": 71.91,
  "text": "180+ students are already learning this way at J3 Mall."
 },
 {
  "t0": 72.25,
  "t1": 74.322,
  "text": "And S.A.M is growing."
 },
 {
  "t0": 76.25,
  "t1": 79.663,
  "text": "New branches in Meydan and Al Barsha."
 },
 {
  "t0": 80.25,
  "t1": 82.862,
  "text": "And AB Centre, opening soon."
 },
 {
  "t0": 84.25,
  "t1": 87.869,
  "text": "S.A.M Singapore Maths. Come and see the bars."
 }
