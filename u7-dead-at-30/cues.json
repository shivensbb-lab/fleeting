[
 {
  "t0": 0.1,
  "t1": 3.0833333333333335,
  "text": "Medieval life: old at 30."
 },
 {
  "t0": 3.2333333333333334,
  "t1": 5.65,
  "text": "Except... not really."
 },
 {
  "t0": 5.8,
  "t1": 8.316666666666666,
  "text": "Dead at 30? The average trick."
 },
 {
  "t0": 8.466666666666667,
  "t1": 11.783333333333333,
  "text": "Life expectancy was around 30."
 },
 {
  "t0": 11.933333333333334,
  "t1": 13.983333333333334,
  "text": "But that's an average."
 },
 {
  "t0": 14.133333333333335,
  "t1": 17.45,
  "text": "And many babies didn't make it to 5."
 },
 {
  "t0": 17.6,
  "t1": 20.45,
  "text": "That drags the average way down."
 },
 {
  "t0": 20.6,
  "t1": 23.716666666666665,
  "text": "One baby. One 60-year-old."
 },
 {
  "t0": 23.866666666666667,
  "t1": 26.249999999999996,
  "text": "Average age: 30."
 },
 {
  "t0": 26.4,
  "t1": 28.783333333333328,
  "text": "Neither died at 30."
 },
 {
  "t0": 28.93333333333333,
  "t1": 32.65,
  "text": "Make it to adulthood, and you'd often see 50."
 },
 {
  "t0": 32.8,
  "t1": 35.35,
  "text": "Or 60. Or 70."
 },
 {
  "t0": 35.5,
  "t1": 37.85,
  "text": "Plenty of grandparents."
 },
 {
  "t0": 38.0,
  "t1": 42.11666666666667,
  "text": "Queen Eleanor of Aquitaine lived to about 80."
 },
 {
  "t0": 42.266666666666666,
  "t1": 44.31666666666667,
  "text": "So why the myth?"
 },
 {
  "t0": 44.46666666666667,
  "t1": 47.68333333333334,
  "text": "People read the average as a lifespan."
 },
 {
  "t0": 47.833333333333336,
  "t1": 49.88333333333334,
  "text": "Two different numbers."
 },
 {
  "t0": 50.03333333333334,
  "t1": 53.550000000000004,
  "text": "Average: 30. Adults: much older."
 },
 {
  "t0": 53.7,
  "t1": 56.31666666666667,
  "text": "Dead at 30: not the rule."
 },
 {
  "t0": 56.46666666666667,
  "t1": 60.45,
  "text": "Anyway, here's a medieval peasant at 30."
 }
