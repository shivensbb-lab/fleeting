[
 {
  "t0": 0.1,
  "t1": 3.1833333333333336,
  "text": "The Middle Ages. The iron maiden."
 },
 {
  "t0": 3.3333333333333335,
  "t1": 5.916666666666667,
  "text": "Except... it's probably fake."
 },
 {
  "t0": 6.066666666666666,
  "t1": 8.483333333333333,
  "text": "The iron maiden myth."
 },
 {
  "t0": 8.633333333333333,
  "t1": 12.049999999999999,
  "text": "No medieval record describes one."
 },
 {
  "t0": 12.2,
  "t1": 15.75,
  "text": "The story starts in 1793."
 },
 {
  "t0": 15.9,
  "t1": 18.85,
  "text": "A German writer makes a claim."
 },
 {
  "t0": 19.000000000000004,
  "t1": 22.916666666666668,
  "text": "A forger was killed in one, in 1515."
 },
 {
  "t0": 23.06666666666667,
  "t1": 25.35,
  "text": "His sources? None."
 },
 {
  "t0": 25.500000000000004,
  "t1": 28.316666666666666,
  "text": "Then museums wanted one."
 },
 {
  "t0": 28.46666666666667,
  "t1": 31.849999999999998,
  "text": "So in the 1800s, people built them."
 },
 {
  "t0": 32.0,
  "t1": 34.88333333333333,
  "text": "From old armour and spare parts."
 },
 {
  "t0": 35.03333333333333,
  "t1": 38.75,
  "text": "The famous one in Nuremberg? Assembled."
 },
 {
  "t0": 38.9,
  "t1": 41.083333333333336,
  "text": "It drew huge crowds."
 },
 {
  "t0": 41.233333333333334,
  "t1": 45.91666666666667,
  "text": "It was destroyed in a bombing raid in 1944."
 },
 {
  "t0": 46.06666666666667,
  "t1": 49.083333333333336,
  "text": "Copies still sit in museums."
 },
 {
  "t0": 49.233333333333334,
  "t1": 52.75,
  "text": "Real medieval punishments were bad enough."
 },
 {
  "t0": 52.9,
  "t1": 55.75,
  "text": "No spiky cabinet required."
 },
 {
  "t0": 55.9,
  "t1": 59.35,
  "text": "Medieval iron maidens found: zero."
 },
 {
  "t0": 59.5,
  "t1": 62.550000000000004,
  "text": "Built in the 1800s: several."
 },
 {
  "t0": 62.7,
  "t1": 66.41666666666667,
  "text": "Anyway, here's a medieval iron maiden."
 }
]